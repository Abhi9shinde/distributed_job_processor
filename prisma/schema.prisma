// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  QUEUED
  PROCESSING
  RETRYING
  COMPLETED
  FAILED
}

enum OutBoxStatus {
  PENDING
  PUBLISHED
}

model Job {
  id                       String        @id @default(cuid())
  type                     String //identifies job 
  payload                  Json
  status                   JobStatus     @default(QUEUED)
  attempts                 Int           @default(0)
  maxAttempts              Int           @default(3)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  outboxEvents             OutBoxEvent[]
  currentAttemptId         String?
  processingLeaseExpiresAt DateTime?

  @@index([status, processingLeaseExpiresAt])
}

model OutBoxEvent {
  id           String       @id @default(cuid())
  jobId        String //foreign key to Job OR identifies the job that generated this event
  eventType    String
  payload      Json
  status       OutBoxStatus @default(PENDING)
  attempts     Int          @default(0) //these are publish attempts, not job attempts
  lastError    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  publishedAt  DateTime?
  claimToken   String?
  claimedUntil DateTime?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([jobId])
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique // this is the key that identifies the idempotent operation
  jobId          String
  result         Json?
  createdAt      DateTime @default(now())

  @@index([jobId])
}

model JobEffect {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  jobId          String
  effectType     String
  payload        Json
  createdAt      DateTime @default(now())

  @@index([jobId])
}
